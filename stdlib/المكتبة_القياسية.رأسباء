// واجهات مكتبة باء القياسية (v0.6.2)
// ملاحظة الملكية:
// - نسخ_نص ودمج_نص يعيدان نصاً مخصصاً على heap.
// - يجب تحرير النتيجة لاحقاً عبر حرر_نص.

صحيح طول_نص(نص س).
صحيح قارن_نص(نص أ، نص ب).
نص نسخ_نص(نص س).
نص دمج_نص(نص أ، نص ب).
عدم حرر_نص(نص س).

// واجهات الذاكرة الديناميكية (v0.3.11)
// ملاحظة الملكية:
// - حجز_ذاكرة وإعادة_حجز يعيدان مؤشراً مخصصاً على heap (قد يكون عدم عند الفشل).
// - يجب تحرير النتيجة لاحقاً عبر تحرير_ذاكرة.
// - نسخ_ذاكرة وتعيين_ذاكرة لا تحجز ذاكرة؛ تعيدان نفس مؤشر الوجهة.

عدم* حجز_ذاكرة(صحيح عدد_بايتات).
عدم تحرير_ذاكرة(عدم* مؤشر).
عدم* إعادة_حجز(عدم* مؤشر، صحيح عدد_بايتات).
عدم* نسخ_ذاكرة(عدم* وجهة، عدم* مصدر، صحيح عدد_بايتات).
عدم* تعيين_ذاكرة(عدم* مؤشر، صحيح قيمة، صحيح عدد_بايتات).

// واجهات المتجه الديناميكي (v0.6.2)
// ملاحظات الملكية:
// - أنشئ_متجه يعيد مقبضاً معتماً على heap أو "عدم" عند فشل الحجز أو عند حجم عنصر غير صالح.
// - حرر_متجه يحرر المقبض ومخزن العناصر الداخلي؛ لا يحرر المؤشرات المخزنة كعناصر.
// - ادفع_متجه ينسخ عدد بايتات يساوي حجم العنصر من عنوان العنصر إلى المتجه.
// - اسحب_متجه ينسخ آخر عنصر إلى وجهة اختيارية؛ مرر "عدم" لتجاهل القيمة المسحوبة.
// - بيانات_متجه يعيد مؤشراً داخلياً غير مملوك للمستدعي وقد يتغير بعد ادفع_متجه.

نوع متجه = عدم*.
متجه أنشئ_متجه(صحيح حجم_العنصر).
عدم حرر_متجه(متجه م).
صحيح طول_متجه(متجه م).
صحيح سعة_متجه(متجه م).
عدم* بيانات_متجه(متجه م).
منطقي ادفع_متجه(متجه م، عدم* عنصر).
منطقي اسحب_متجه(متجه م، عدم* وجهة).

// واجهات مخزن البايتات (v0.6.2)
// ملاحظات الملكية:
// - مخزن_بايتات مقبض معتم مخصص على heap؛ يجب تحريره عبر حرر_مخزن_بايتات.
// - بيانات_مخزن_بايتات يعيد مؤشراً داخلياً مستعاراً؛ لا يحرره المستدعي وقد يتغير بعد أضف_بايت.
// - أضف_بايت يضيف قيمة ط٨ واحدة إلى نهاية المخزن، ويعيد خطأ عند فشل التوسيع.

نوع مخزن_بايتات = عدم*.
مخزن_بايتات أنشئ_مخزن_بايتات().
عدم حرر_مخزن_بايتات(مخزن_بايتات م).
صحيح طول_مخزن_بايتات(مخزن_بايتات م).
صحيح سعة_مخزن_بايتات(مخزن_بايتات م).
عدم* بيانات_مخزن_بايتات(مخزن_بايتات م).
منطقي أضف_بايت(مخزن_بايتات م، ط٨ قيمة).

// واجهات باني النص (v0.6.2)
// ملاحظات الملكية:
// - أنشئ_باني_نص يعيد مقبضاً معتماً على heap أو "عدم" عند فشل الحجز.
// - حرر_باني_نص يحرر المقبض ومخزنه الداخلي.
// - نص_الباني يعيد لقطة نصية جديدة على heap؛ يجب تحريرها عبر حرر_نص أو تحرير_ذاكرة.
// - أضف_نص_للباني ينسخ النص المعطى إلى المخزن الداخلي ولا يحتفظ بمؤشر إليه.

نوع باني_نص = عدم*.
باني_نص أنشئ_باني_نص().
عدم حرر_باني_نص(باني_نص ب).
صحيح طول_باني_نص(باني_نص ب).
منطقي أضف_نص_للباني(باني_نص ب، نص قيمة).
عدم امسح_باني_نص(باني_نص ب).
نص نص_الباني(باني_نص ب).

// واجهات المسارات (v0.6.2)
// ملاحظات الملكية:
// - كل دالة هنا تعيد نصاً جديداً على heap أو "عدم" عند فشل الحجز الداخلي.
// - يجب تحرير النص الناتج عبر حرر_نص أو تحرير_ذاكرة.
// - طبع_مسار يوحد الفواصل إلى "/"، ويضغط الفواصل المتكررة، ويزيل الفاصل النهائي إلا للجذر.

نص ضم_مسار(نص أساس، نص جزء).
نص مجلد_مسار(نص مسار).
نص اسم_ملف_مسار(نص مسار).
نص امتداد_مسار(نص مسار).
نص طبع_مسار(نص مسار).

// واجهات إدخال/إخراج الملفات (v0.3.12)
// ملاحظات:
// - "عدم*" هنا يمثل مقبض ملف (FILE*) بشكل معتم.
// - فتح_ملف يعيد "عدم" عند الفشل.
// - اقرأ_سطر يعيد "عدم" عند EOF قبل قراءة أي بايت.
// - اقرأ_سطر يعيد نصاً مخصصاً على heap ويجب تحريره عبر حرر_نص (أو تحرير_ذاكرة).

عدم* فتح_ملف(نص مسار، نص وضع).
صحيح اغلق_ملف(عدم* ملف).
حرف اقرأ_حرف(عدم* ملف).
صحيح اكتب_حرف(عدم* ملف، حرف ح).
صحيح اقرأ_ملف(عدم* ملف، عدم* مخزن، صحيح عدد_بايتات).
صحيح اكتب_ملف(عدم* ملف، عدم* بيانات، صحيح عدد_بايتات).
منطقي نهاية_ملف(عدم* ملف).
صحيح موقع_ملف(عدم* ملف).
صحيح اذهب_لموقع(عدم* ملف، صحيح موقع).
نص اقرأ_سطر(عدم* ملف).
صحيح اكتب_سطر(عدم* ملف، نص سطر).

// واجهات الرياضيات (v0.4.2)
// ملاحظات:
// - جذر_تربيعي وأس يعملان على نوع "عشري" ويعتمدان على libm.
// - جيب/جيب_تمام/ظل توفر دوال مثلثية أساسية (بالراديان).
// - مطلق يعمل على الأعداد الصحيحة (صحيح).
// - عشوائي يعيد قيمة شبه عشوائية غير سالبة.

عشري جذر_تربيعي(عشري قيمة).
عشري أس(عشري أساس، عشري قوة).
عشري جيب(عشري زاوية).
عشري جيب_تمام(عشري زاوية).
عشري ظل(عشري زاوية).
صحيح مطلق(صحيح قيمة).
صحيح عشوائي().

// واجهات النظام (v0.4.1)
// ملاحظات:
// - متغير_بيئة يعيد نصاً جديداً (heap) أو "عدم" إذا لم يوجد المتغير.
// - يجب تحرير النص الناتج من متغير_بيئة عبر حرر_نص/تحرير_ذاكرة.

نص متغير_بيئة(نص اسم).
صحيح نفذ_أمر(نص أمر).

// واجهة العمليات المهيكلة (v0.6.5)
// - لا تستخدم shell: كل عنصر في وسائط يصل إلى العملية كما هو.
// - مجلد_العمل = عدم يرث مجلد العملية الحالية.
// - بيئة = عدم وعدد_البيئة = 0 يرثان البيئة؛ وإلا تستبدل القائمة البيئة كاملة
//   بعناصر على صورة "اسم=قيمة".
// - مسار_الخرج/مسار_الخطأ = عدم يرثان القناة المقابلة، والمسار يعيد التوجيه
//   إلى ملف. تمرير المسار نفسه يدمج القناتين.
// - ابدأ_عملية يعيد عدم عند فشل البدء. يجب تحرير المقبض عبر حرر_عملية.
// - حالة_عملية: 0 تعمل، 1 انتهت، -1 خطأ. انتظر_عملية يعيد كود الخروج.

نوع مقبض_عملية = عدم*.
مقبض_عملية ابدأ_عملية(نص[] وسائط، صحيح عدد_الوسائط، نص مجلد_العمل،
                      نص[] بيئة، صحيح عدد_البيئة، نص مسار_الخرج، نص مسار_الخطأ).
صحيح حالة_عملية(مقبض_عملية عملية).
صحيح انتظر_عملية(مقبض_عملية عملية).
منطقي الغ_عملية(مقبض_عملية عملية).
صحيح كود_خروج_عملية(مقبض_عملية عملية).
عدم حرر_عملية(مقبض_عملية عملية).

// عمليات ملفات لازمة لمسارات البناء دون أدوات نظام خارجية.
صحيح انشئ_مجلدات(نص مسار).
صحيح احذف_شجرة(نص مسار).

// يعيد شا-٢٥٦ للملف كنص ست عشري صغير من ٦٤ خانة، أو عدم عند فشل القراءة.
// النص الناتج مملوك للمستدعي ويحرر عبر حرر_نص/تحرير_ذاكرة.
نص تجزئة_ملف_شا٢٥٦(نص مسار).

// واجهات الوقت (v0.4.1)
// ملاحظات:
// - وقت_حالي يعيد عدد الثواني منذ Unix Epoch.
