// ============================================================================
// برنامج تفاضلي: الأعداد العشرية والمنطق والاختيار — v0.7.3
// ============================================================================
// عمليات عشرية وتحويلات صحيح↔عشري، ومقارنات، وتقييم قصير الدائرة له آثار
// جانبية (يجب ألا يحذفه أي تحسين)، و«اختر» مع السقوط بين الحالات.
// ============================================================================

صحيح نداءات = 0.

منطقي سجل(منطقي ق) {
    نداءات = نداءات + 1.
    إرجع ق.
}

صحيح صنف(صحيح س) {
    صحيح ن = 0.
    اختر (س) {
        حالة 0:
            ن = ن + 1.
        حالة 1:
            ن = ن + 10.
            توقف.
        حالة 2:
            ن = ن + 100.
            توقف.
        حالة 5:
        حالة 6:
            ن = ن + 1000.
            توقف.
        افتراضي:
            ن = -1.
            توقف.
    }
    إرجع ن.
}

عشري متعدد(عشري س) {
    إرجع ((2.0 * س - 3.0) * س + 0.5) * س - 1.25.
}

صحيح الرئيسية() {
    لكل (صحيح ي = -4؛ ي <= 4؛ ي++) {
        عشري س = كـ<عشري>(ي) * 0.75.
        اطبع متعدد(س).
        اطبع س / 3.0.
        اطبع كـ<صحيح>(س * 10.0).
        إذا (س < 0.0) {
            اطبع "سالب".
        } وإلا إذا (س == 0.0) {
            اطبع "صفر".
        } وإلا {
            اطبع "موجب".
        }
    }

    عشري تراكم = 0.0.
    لكل (صحيح ي = 1؛ ي <= 20؛ ي++) {
        تراكم = تراكم + 1.0 / كـ<عشري>(ي).
    }
    اطبع تراكم.
    اطبع كـ<صحيح>(تراكم * 1000000.0).

    // قصر الدائرة: عدد نداءات «سجل» جزء من الناتج.
    صحيح عدد_صواب = 0.
    لكل (صحيح ي = 0؛ ي < 8؛ ي++) {
        إذا (سجل(ي % 2 == 0) && سجل(ي % 3 == 0)) {
            عدد_صواب++.
        }
        إذا (سجل(ي > 5) || سجل(ي == 1)) {
            عدد_صواب = عدد_صواب + 10.
        }
    }
    اطبع عدد_صواب.
    اطبع نداءات.

    لكل (صحيح ي = -1؛ ي < 8؛ ي++) {
        اطبع صنف(ي).
    }

    منطقي أ = صواب.
    منطقي ب = خطأ.
    اطبع !أ.
    اطبع أ && !ب.
    اطبع (أ || ب) && !(أ && ب).
    إرجع 0.
}
