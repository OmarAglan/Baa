// ============================================================================
// برنامج تفاضلي: العمليات الصحيحة — v0.7.3
// ============================================================================
// يطبع نتائج الحساب والقسمة والباقي والإزاحة والعمليات البتية على قيم
// تمر عبر معاملات دوال حتى لا يطويها -O0، ثم يقارن المشغّل الناتج بين
// مستويات التحسين. أي اختلاف في السطور يعني أن تحسيناً غيّر المعنى.
// ============================================================================

صحيح امزج(صحيح أ, صحيح ب) {
    صحيح س = أ * 31 + ب.
    س = س ^ (س >> 7).
    إرجع س.
}

عدم اطبع_حساب(صحيح أ, صحيح ب) {
    اطبع أ + ب.
    اطبع أ - ب.
    اطبع أ * ب.
    إذا (ب != 0) {
        اطبع أ / ب.
        اطبع أ % ب.
    }
    اطبع أ & ب.
    اطبع أ | ب.
    اطبع أ ^ ب.
    اطبع ~أ.
    اطبع -ب.
}

عدم اطبع_إزاحة(صحيح أ, ط٦٤ غ) {
    لكل (صحيح ن = 0؛ ن < 64؛ ن = ن + 9) {
        اطبع أ << ن.
        اطبع أ >> ن.
        اطبع غ >> ن.
    }
}

صحيح الرئيسية() {
    صحيح قيم[8] = {0, 1, -1, 7, -13, 1000003, -2147483648, 9223372036854775807}.
    صحيح بصمة = 17.

    لكل (صحيح ي = 0؛ ي < 8؛ ي++) {
        لكل (صحيح ي٢ = 0؛ ي٢ < 8؛ ي٢++) {
            اطبع_حساب(قيم[ي], قيم[ي٢]).
            بصمة = امزج(بصمة, قيم[ي] * 3 - قيم[ي٢]).
        }
    }

    اطبع_إزاحة(-123456789, كـ<ط٦٤>(-1)).
    اطبع_إزاحة(81985529216486895, كـ<ط٦٤>(81985529216486895)).

    // قسمة وباقي بالإشارات المختلطة وقسمة على قوى ٢ (تُحوّل إلى إزاحة عند التحسين).
    لكل (صحيح س = -9؛ س <= 9؛ س++) {
        اطبع س / 4.
        اطبع س % 4.
        اطبع س / -3.
        اطبع س % -3.
        اطبع س * 8.
        اطبع س * 10.
    }

    اطبع بصمة.
    إرجع 0.
}
