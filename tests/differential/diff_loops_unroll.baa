// ============================================================================
// برنامج تفاضلي: الحلقات والفك — v0.7.3
// ============================================================================
// حلقات بعدد ثابت (مرشحة لـ -funroll-loops)، وأعداد تكرار من ٠ إلى ٩،
// وحلقات متداخلة، و«توقف»/«استمر»، و«طالما»، ومصفوفات تُقرأ وتُكتب داخل الحلقة.
// ============================================================================

صحيح مجموع_حتى(صحيح ن) {
    صحيح م = 0.
    لكل (صحيح ي = 0؛ ي < ن؛ ي++) {
        م = م + ي * ي.
    }
    إرجع م.
}

صحيح الرئيسية() {
    // أعداد تكرار صغيرة: حالات الحدود لفك الحلقات.
    لكل (صحيح ن = 0؛ ن < 10؛ ن++) {
        اطبع مجموع_حتى(ن).
    }

    // حلقات بعدد ثابت.
    صحيح أ[8].
    لكل (صحيح ي = 0؛ ي < 8؛ ي++) {
        أ[ي] = ي * 3 - 5.
    }
    صحيح م = 0.
    لكل (صحيح ي = 0؛ ي < 8؛ ي++) {
        م = م * 7 + أ[ي].
    }
    اطبع م.

    صحيح ج = 1.
    لكل (صحيح ي = 0؛ ي < 4؛ ي++) {
        ج = ج * 3.
        اطبع ج.
    }

    // حلقات متداخلة مع توقف واستمر.
    صحيح عداد = 0.
    لكل (صحيح ي = 0؛ ي < 12؛ ي++) {
        إذا (ي % 3 == 0) {
            استمر.
        }
        لكل (صحيح ي٢ = 0؛ ي٢ < 12؛ ي٢++) {
            إذا (ي٢ > ي) {
                توقف.
            }
            عداد = عداد + ي * ي٢.
        }
        اطبع عداد.
    }

    // طالما مع تحديث متغيرين (Collatz).
    لكل (صحيح بدء = 1؛ بدء < 30؛ بدء = بدء + 7) {
        صحيح س = بدء.
        صحيح خطوات = 0.
        طالما (س != 1) {
            إذا (س % 2 == 0) {
                س = س / 2.
            } وإلا {
                س = 3 * س + 1.
            }
            خطوات++.
        }
        اطبع خطوات.
    }

    // مصفوفة ثنائية الأبعاد ومتغير حلقة يُستخدم بعد الحلقة.
    صحيح شبكة[4][5].
    لكل (صحيح ص = 0؛ ص < 4؛ ص++) {
        لكل (صحيح ع = 0؛ ع < 5؛ ع++) {
            شبكة[ص][ع] = ص * 10 + ع.
        }
    }
    صحيح ك = 0.
    صحيح آخر = 0.
    لكل (ك = 0؛ ك < 20؛ ك = ك + 3) {
        آخر = شبكة[ك / 5][ك % 5].
    }
    اطبع ك.
    اطبع آخر.

    // حلقة عكسية بعدد غير موقع.
    ط٦٤ ع٢ = 5.
    طالما (ع٢ > 0) {
        ع٢ = ع٢ - 1.
        اطبع ع٢.
    }
    إرجع 0.
}
