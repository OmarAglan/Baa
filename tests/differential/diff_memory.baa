// ============================================================================
// برنامج تفاضلي: الذاكرة والهياكل والمؤشرات — v0.7.3
// ============================================================================
// تخزين وتحميل عبر مؤشرات واسماء مستعارة (aliasing)، وهياكل ومصفوفات هياكل،
// ومتغيرات عامة. يكشف حذف تخزين أو تحميل أو إعادة استخدام قيمة قديمة (CSE)
// بعد كتابة عبر مؤشر.
// ============================================================================

هيكل نقطة {
    صحيح س.
    صحيح ص.
    ص٨ وسم.
}

صحيح عام_عداد = 3.
صحيح عام_مصفوفة[6] = {1, 2, 3, 4, 5, 6}.

عدم زد(صحيح* م, صحيح مقدار) {
    *م = *م + مقدار.
}

عدم انقل(صحيح* س, صحيح* ص, صحيح دس, صحيح دص) {
    *س = *س + دس.
    *ص = *ص + دص.
}

صحيح الرئيسية() {
    // اسم مستعار: الكتابة عبر المؤشر يجب أن تُرى في القراءة التالية.
    صحيح أ = 10.
    صحيح* م = &أ.
    صحيح قبل = أ + 1.
    *م = 20.
    صحيح بعد = أ + 1.
    اطبع قبل.
    اطبع بعد.
    زد(&أ, 5).
    اطبع أ.

    // مؤشران لنفس العنصر.
    صحيح ق[5] = {5, 4, 3, 2, 1}.
    صحيح* م١ = &ق[2].
    صحيح* م٢ = &ق[0] + 2.
    *م١ = 30.
    اطبع *م٢.
    *م٢ = *م٢ * 2.
    اطبع ق[2].
    اطبع م٢ - م١.
    اطبع (م١ + 2) - &ق[0].

    // هياكل.
    هيكل نقطة ن = { س: 1, ص: -2 }.
    لكل (صحيح ي = 0؛ ي < 5؛ ي++) {
        انقل(&ن:س, &ن:ص, ي, -ي * 3).
        ن:وسم = كـ<ص٨>(ن:وسم + 1).
        اطبع ن:س.
        اطبع ن:ص.
        اطبع ن:وسم.
    }

    // عناصر مصفوفة هياكل (الفهارس ثابتة: قيد حالي في باء).
    هيكل نقطة نقاط[3].
    نقاط[0]:س = 4.
    نقاط[1]:س = نقاط[0]:س * 3.
    نقاط[2]:س = نقاط[1]:س - نقاط[0]:س.
    نقاط[0]:ص = -7.
    نقاط[1]:ص = نقاط[0]:ص + نقاط[2]:س.
    نقاط[2]:ص = 0.
    نقاط[2]:وسم = كـ<ص٨>(-3).
    انقل(&نقاط[2]:س, &نقاط[2]:ص, 5, 6).
    صحيح مجموع = 0.
    مجموع = نقاط[0]:س * نقاط[0]:ص + نقاط[1]:س * نقاط[1]:ص.
    مجموع = مجموع + نقاط[2]:س * نقاط[2]:ص + كـ<صحيح>(نقاط[2]:وسم).
    اطبع مجموع.
    اطبع حجم(هيكل نقطة).

    // متغيرات عامة تُعدّل عبر مؤشر وتُقرأ مباشرة.
    زد(&عام_عداد, 4).
    اطبع عام_عداد.
    صحيح* عم = &عام_مصفوفة[1].
    لكل (صحيح ي = 0؛ ي < 5؛ ي++) {
        *(عم + ي - 1) = عم[ي - 1] * عام_عداد.
    }
    لكل (صحيح ي = 0؛ ي < 6؛ ي++) {
        اطبع عام_مصفوفة[ي].
    }

    // ذاكرة ديناميكية.
    صحيح* كتلة = كـ<صحيح*>(حجز_ذاكرة(8 * 16)).
    لكل (صحيح ي = 0؛ ي < 16؛ ي++) {
        *(كتلة + ي) = ي * ي - 7.
    }
    صحيح م٣ = 0.
    لكل (صحيح ي = 15؛ ي >= 0؛ ي--) {
        م٣ = م٣ * 3 + كتلة[ي].
    }
    اطبع م٣.
    تحرير_ذاكرة(كـ<عدم*>(كتلة)).
    إرجع 0.
}
