// ============================================================================
// برنامج تفاضلي: الأحجام الضيقة والتحويلات — v0.7.3
// ============================================================================
// يغطي التوسيع بالإشارة وبالأصفار والاقتطاع لثوابت ومتغيرات. هذا الصنف من
// الأخطاء ظهر أولاً في -O0 (movsx بمصدر فوري) لأن الطي الثابت يخفيه في -O2.
// ============================================================================

ص٨ كصغير(صحيح س) {
    إرجع كـ<ص٨>(س).
}

ط٨ كبايت(صحيح س) {
    إرجع كـ<ط٨>(س).
}

عدم اطبع_تحويلات(صحيح س) {
    ص٨ أ = كـ<ص٨>(س).
    ط٨ ب = كـ<ط٨>(س).
    ص١٦ ج = كـ<ص١٦>(س).
    ط١٦ د = كـ<ط١٦>(س).
    ص٣٢ هـ = كـ<ص٣٢>(س).
    ط٣٢ و = كـ<ط٣٢>(س).
    اطبع أ.
    اطبع ب.
    اطبع ج.
    اطبع د.
    اطبع هـ.
    اطبع و.
    اطبع كـ<صحيح>(أ) + كـ<صحيح>(ب).
    اطبع كـ<ط٦٤>(أ).
    اطبع كـ<صحيح>(و) * 2.
}

صحيح الرئيسية() {
    صحيح قيم[10] = {0, 1, 127, 128, 255, 256, -1, -128, 65535, 4294967295}.
    لكل (صحيح ي = 0؛ ي < 10؛ ي++) {
        اطبع_تحويلات(قيم[ي]).
        اطبع_تحويلات(قيم[ي] * 257 + 3).
    }

    // تحويلات ثوابت مباشرة: تصل إلى الخلفية كمعاملات فورية في -O0.
    ص٨ ث١ = كـ<ص٨>(200).
    ط٨ ث٢ = كـ<ط٨>(-56).
    ص١٦ ث٣ = كـ<ص١٦>(40000).
    ط٣٢ ث٤ = كـ<ط٣٢>(-1).
    اطبع ث١.
    اطبع ث٢.
    اطبع ث٣.
    اطبع ث٤.
    اطبع كـ<صحيح>(كـ<ص٨>(-1)).
    اطبع كـ<ط٦٤>(كـ<ط٨>(-1)).
    اطبع كـ<صحيح>(كـ<ص١٦>(32768)).
    اطبع كـ<صحيح>(كـ<ص٣٢>(2147483648)).

    // حلقة على بايتات مع التفاف.
    ط٨ ع = 250.
    ص٨ م = 120.
    لكل (صحيح ي = 0؛ ي < 12؛ ي++) {
        ع = ع + 1.
        م = م + 1.
        اطبع ع.
        اطبع م.
        اطبع كصغير(ي * 37).
        اطبع كبايت(ي * -37).
    }

    منطقي ص = صواب.
    منطقي خ = خطأ.
    اطبع كـ<صحيح>(ص) + كـ<صحيح>(خ).
    حرف ح = 'أ'.
    اطبع كـ<صحيح>(ح).
    إرجع 0.
}
