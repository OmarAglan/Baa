// RUN: expect-pass,runtime
// EXPECT-OUT: PASS

صحيح الرئيسية() {
    صحيح نتيجة = ٠.

    صحيح مجموع = ١٢٣ + ٤٥.
    إذا (مجموع == ١٦٨) {
        نتيجة = نتيجة + ١.
    }

    ص٨ صغير = ١٢.
    إذا (صغير == ١٢) {
        نتيجة = نتيجة + ١.
    }

    ط٨ طبيعي = ٢٥٠.
    إذا (طبيعي == ٢٥٠) {
        نتيجة = نتيجة + ١.
    }

    صحيح فرق = -٣ + ٥.
    إذا (فرق == ٢) {
        نتيجة = نتيجة + ١.
    }

    إذا (نتيجة == ٤) {
        اطبع "PASS".
        إرجع ٠.
    }

    إرجع ١.
}
