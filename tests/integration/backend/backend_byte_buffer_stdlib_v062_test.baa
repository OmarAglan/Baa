#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

صحيح الرئيسية() {
    مخزن_بايتات مخزن = أنشئ_مخزن_بايتات().
    تحقق(مخزن != عدم، "أنشئ_مخزن_بايتات: مقبض غير فارغ").
    إذا (مخزن == عدم) { إرجع ١. }

    تحقق(طول_مخزن_بايتات(مخزن) == ٠، "طول_مخزن_بايتات: يبدأ بصفر").
    تحقق(سعة_مخزن_بايتات(مخزن) == ٠، "سعة_مخزن_بايتات: تبدأ بصفر").
    تحقق(بيانات_مخزن_بايتات(مخزن) == عدم، "بيانات_مخزن_بايتات: يبدأ بدون مخزن").

    لكل (صحيح س = ٠؛ س < ٦؛ س = س + ١) {
        ط٨ قيمة = كـ<ط٨>(٦٥ + س).
        تحقق(أضف_بايت(مخزن، قيمة)، "أضف_بايت: نجاح").
    }

    تحقق(طول_مخزن_بايتات(مخزن) == ٦، "طول_مخزن_بايتات: بعد الإضافة").
    تحقق(سعة_مخزن_بايتات(مخزن) >= ٦، "سعة_مخزن_بايتات: توسعت لتكفي البايتات").

    ط٨* بيانات = كـ<ط٨*>(بيانات_مخزن_بايتات(مخزن)).
    تحقق(بيانات != عدم، "بيانات_مخزن_بايتات: مخزن غير فارغ").
    لكل (صحيح س = ٠؛ س < ٦؛ س = س + ١) {
        تحقق(*(بيانات + س) == كـ<ط٨>(٦٥ + س)، "بيانات_مخزن_بايتات: ترتيب البايتات").
    }

    حرر_مخزن_بايتات(مخزن).
    حرر_مخزن_بايتات(عدم).

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }
    اطبع "FAIL".
    إرجع ١.
}
