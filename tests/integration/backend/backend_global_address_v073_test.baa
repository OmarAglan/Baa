// ============================================================================
// اختبار عنوان المتغير العام كقيمة — v0.7.3
// ============================================================================
// كان `&عام` بعد تحويل نوع المؤشر يُخفض إلى تحميل محتوى المتغير (movq ع(%rip))
// بدل عنوانه (leaq)، فتكتب الدالة المستدعاة إلى عنوان خاطئ وينهار البرنامج.
// RUN: expect-pass runtime
// ============================================================================

صحيح عداد = 3.
صحيح جدول[4] = {10, 20, 30, 40}.

عدم زد(صحيح* م, صحيح مقدار) {
    *م = *م + مقدار.
}

صحيح* عنوان_العداد() {
    إرجع &عداد.
}

صحيح الرئيسية() {
    زد(&عداد, 4).
    إذا (عداد != 7) { إرجع 1. }

    صحيح* م = عنوان_العداد().
    *م = 11.
    إذا (عداد != 11) { إرجع 2. }
    إذا (م != &عداد) { إرجع 3. }

    صحيح* م٢ = &جدول[2].
    *م٢ = *م٢ + 1.
    إذا (جدول[2] != 31) { إرجع 4. }
    زد(&جدول[0], 5).
    إذا (جدول[0] != 15) { إرجع 5. }

    اطبع "PASS".
    إرجع 0.
}
