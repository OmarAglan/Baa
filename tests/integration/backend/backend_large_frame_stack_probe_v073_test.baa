#تضمين "stdlib/baalib.baahd"

// إطار أكبر من صفحة: على Windows يُلمس كل صفحة بالترتيب عند حجزه، وإلا
// تقفز أول كتابة فوق صفحة الحراسة فيُنهى البرنامج بلا معالج استثناء.

صحيح ملء(صحيح بداية) {
    صحيح ق[٦٥٥٣٦].
    // أول كتابة في أدنى عنوان من الإطار، بعيدا عن صفحة الحراسة.
    ق[٠] = بداية.
    صحيح م = ١.
    طالما (م < ٦٥٥٣٦) {
        ق[م] = ق[م - ١] + ١.
        م = م + ١.
    }
    إرجع ق[٦٥٥٣٥] - ق[٠].
}

صحيح عمق(صحيح ن) {
    إذا (ن == ٠) { إرجع ملء(ن). }
    إرجع عمق(ن - ١).
}

صحيح الرئيسية() {
    صحيح فشل = ٠.
    إذا (ملء(٣) != ٦٥٥٣٥) { فشل = فشل + ١. }
    إذا (عمق(٤) != ٦٥٥٣٥) { فشل = فشل + ١. }
    إذا (فشل != ٠) {
        اطبع "فشل الإطار الكبير".
    }
    إرجع فشل.
}
