// ============================================================================
// اختبار إصلاحات الثوابت الحرفية والعددية — v0.7.3
// ============================================================================
// - `#تعريف حد ١٠٠` كان يُستبدل بأرقام عربية-هندية خام فيرفضها المحلل
//   بـ«رقم غير صالح».
// - `'\٠'` كان يُرفض بـ«حرف UTF-8 غير صالح» لأن قيمته سلسلة C فارغة.
// - `حالة 'أ'` مع تعبير `اختر` صحيح كانت تقارن بالتمثيل المعبأ للحرف
//   بدل نقطة-الكود فلا تتطابق أبداً.
// RUN: expect-pass runtime
// ============================================================================

#تعريف حد ١٠٠
#تعريف نسبة ٢.٥
#تعريف مزيج 1٢3

صحيح صنف(صحيح ن) {
    اختر (ن) {
        حالة '\٠':
            إرجع 1.
        حالة 'a':
            إرجع 2.
        حالة 'أ':
            إرجع 3.
        افتراضي:
            إرجع 0.
    }
    إرجع -1.
}

صحيح الرئيسية() {
    صحيح س = حد.
    عشري ع = نسبة.
    إذا (س != 100) { إرجع 1. }
    إذا (ع != 2.5) { إرجع 2. }
    إذا (مزيج != 123) { إرجع 3. }

    حرف صفر = '\٠'.
    إذا (كـ<صحيح>(صفر) != 0) { إرجع 4. }

    إذا (صنف(0) != 1) { إرجع 5. }
    إذا (صنف(97) != 2) { إرجع 6. }
    إذا (صنف(كـ<صحيح>('أ')) != 3) { إرجع 7. }
    إذا (صنف(5) != 0) { إرجع 8. }

    حرف ح = 'أ'.
    صحيح ن = 0.
    اختر (ح) {
        حالة 'أ':
            ن = 1.
            توقف.
        افتراضي:
            ن = 2.
            توقف.
    }
    إذا (ن != 1) { إرجع 9. }

    اطبع "PASS".
    إرجع 0.
}
