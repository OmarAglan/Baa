#تضمين "stdlib/baalib.baahd"

// && لا يقيّم طرفه الأيمن إذا كان الأيسر خطأ، و|| لا يقيّمه إذا كان الأيسر صوابا،
// في الشروط والإسنادات والحلقات، وفي كل مستويات التحسين.

صحيح نداءات = ٠.

منطقي سجل(منطقي ق) {
    نداءات = نداءات + ١.
    إرجع ق.
}

صحيح الرئيسية(صحيح عدد، نص[] معاملات) {
    صحيح فشل = ٠.
    نص فارغ = عدم.

    // في الشرط: لا نداء للطرف الأيمن.
    إذا (خطأ && سجل(صواب)) { فشل = فشل + ١. }
    إذا (صواب || سجل(خطأ)) { } وإلا { فشل = فشل + ١. }
    إذا (نداءات != ٠) { فشل = فشل + ١. }

    // يقيَّم الطرف الأيمن حين لا يحسم الأيسر النتيجة.
    إذا (صواب && سجل(صواب)) { } وإلا { فشل = فشل + ١. }
    إذا (خطأ || سجل(خطأ)) { فشل = فشل + ١. }
    إذا (نداءات != ٢) { فشل = فشل + ١. }

    // حارس عدم: يتعطل البرنامج لو قيّم طول_نص(عدم).
    إذا (فارغ != عدم && طول_نص(فارغ) > ٠) { فشل = فشل + ١. }
    إذا (فارغ == عدم || طول_نص(فارغ) == ٠) { } وإلا { فشل = فشل + ١. }

    // في الإسناد.
    منطقي م = فارغ != عدم && طول_نص(فارغ) > ٠.
    إذا (م) { فشل = فشل + ١. }
    منطقي ن = فارغ == عدم || طول_نص(فارغ) > ٠.
    إذا (!ن) { فشل = فشل + ١. }

    // معاملات[عدد] عدم، فلا يقرأ طولها.
    إذا (معاملات[عدد] != عدم && طول_نص(معاملات[عدد]) > ٠) { فشل = فشل + ١. }

    // متداخل ومع النفي.
    صحيح قبل = نداءات.
    إذا ((خطأ && سجل(صواب)) || (صواب && !(صواب || سجل(صواب)))) { فشل = فشل + ١. }
    إذا (نداءات != قبل) { فشل = فشل + ١. }

    // في شرط الحلقة: يتوقف التقييم بعد أول خطأ.
    صحيح ي = ٠.
    نداءات = ٠.
    طالما (ي < ٣ && سجل(صواب)) {
        ي = ي + ١.
    }
    إذا (نداءات != ٣) { فشل = فشل + ١. }

    إذا (فشل != ٠) {
        اطبع "فشل التقييم المختصر".
    }
    إرجع فشل.
}
