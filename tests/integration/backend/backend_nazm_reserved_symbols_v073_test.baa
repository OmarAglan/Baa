// ============================================================================
// اختبار أسماء المستخدم المحجوزة في نَظْم — v0.7.3
// ============================================================================
// كانت المتغيرات العامة والدوال المسماة بكلمات عربية شائعة مثل `بيانات` و`مصدر`
// و`قاعدة` تكسر البناء عبر نَظْم، لأنها أسماء سجلات قديمة يرفضها في موضع
// الرمز. يهرّب مولد نَظْم الآن هذه الأسماء وأسماء السجلات والوسوم المولدة.
// RUN: expect-pass runtime
// ============================================================================

صحيح بيانات = 5.
صحيح مصدر[3] = {1, 2, 3}.
صحيح سجل_المركم = 7.
صحيح كتلة_٠_١ = 9.
صحيح رمز_باء_بيانات = 11.

صحيح قاعدة(صحيح س) {
    إرجع س + بيانات.
}

صحيح وجهة() {
    إرجع مصدر[0] + مصدر[1] + مصدر[2].
}

صحيح ر1(صحيح* م) {
    *م = *م * 2.
    إرجع *م.
}

صحيح الرئيسية() {
    إذا (قاعدة(1) != 6) { إرجع 1. }
    إذا (وجهة() != 6) { إرجع 2. }
    إذا (ر1(&بيانات) != 10 || بيانات != 10) { إرجع 3. }
    إذا (سجل_المركم != 7) { إرجع 4. }
    إذا (كتلة_٠_١ != 9) { إرجع 5. }
    // الاسم الذي يبدأ ببادئة التهريب لا يلتقي باسم مهرَّب.
    إذا (رمز_باء_بيانات != 11) { إرجع 6. }

    اطبع "PASS".
    إرجع 0.
}
