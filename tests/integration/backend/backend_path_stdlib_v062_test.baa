#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

عدم تحقق_نص(نص فعلي، نص متوقع، نص رسالة) {
    تحقق(فعلي != عدم، رسالة).
    إذا (فعلي != عدم) {
        إذا (قارن_نص(فعلي، متوقع) != ٠) {
            اطبع "فشل:".
            اطبع رسالة.
            اطبع "فعلي:".
            اطبع فعلي.
            اطبع "متوقع:".
            اطبع متوقع.
            فشل = فشل + ١.
        }
        حرر_نص(فعلي).
    }
}

صحيح الرئيسية() {
    تحقق_نص(طبع_مسار("src\\middle//file.baa/"),
             "src/middle/file.baa",
             "طبع_مسار: توحيد الفواصل").

    تحقق_نص(طبع_مسار("src/"),
             "src",
             "طبع_مسار: إزالة الفاصل النهائي").

    تحقق_نص(ضم_مسار("src/", "middle/file.baa"),
             "src/middle/file.baa",
             "ضم_مسار: لا يكرر الفاصل").

    تحقق_نص(ضم_مسار("", "src//main.baa"),
             "src/main.baa",
             "ضم_مسار: أساس فارغ").

    تحقق_نص(مجلد_مسار("src/middle/file.baa"),
             "src/middle",
             "مجلد_مسار: مجلد مركب").

    تحقق_نص(مجلد_مسار("file.baa"),
             ".",
             "مجلد_مسار: بلا مجلد").

    تحقق_نص(اسم_ملف_مسار("src/middle/file.baa"),
             "file.baa",
             "اسم_ملف_مسار: اسم الملف").

    تحقق_نص(امتداد_مسار("src/middle/file.baa"),
             ".baa",
             "امتداد_مسار: امتداد بنقطة").

    تحقق_نص(امتداد_مسار(".env"),
             "",
             "امتداد_مسار: لا يعد النقطة الأولى امتداداً").

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }
    اطبع "FAIL".
    إرجع ١.
}
