// ============================================================================
// اختبار تحجيم حساب المؤشرات — v0.7.3
// ============================================================================
// `م + ن` يجب أن يتقدم ن عنصراً لا ن×حجم العنصر عنصراً. كان الخفض يضرب
// الإزاحة في حجم العنصر ثم يضربها الخلفي مرة ثانية، فقرأ `*(&ق[0] + 2)`
// خارج المصفوفة. القيمة الخاطئة كانت ثابتة على ويندوز فلم يكشفها الاختبار
// التفاضلي وحده.
// RUN: expect-pass runtime
// ============================================================================

صحيح الرئيسية() {
    // صحيح (8 بايت)
    صحيح ق[5] = {5, 4, 3, 2, 1}.
    صحيح* م = &ق[0] + 2.
    إذا (*م != 3) { إرجع 1. }
    *م = 30.
    إذا (ق[2] != 30) { إرجع 2. }
    إذا (*(2 + &ق[1]) != 2) { إرجع 3. }
    إذا (*(&ق[4] - 3) != 4) { إرجع 4. }
    إذا ((&ق[0] + 4) - &ق[0] != 4) { إرجع 5. }

    // ط٨ (بايت واحد)
    ط٨ ب[4] = {10, 20, 30, 40}.
    ط٨* بم = &ب[0] + 3.
    إذا (*بم != 40) { إرجع 6. }
    إذا (*(بم - 2) != 20) { إرجع 7. }

    // عشري
    عشري ع[3] = {1.5, 2.5, 3.5}.
    عشري* عم = &ع[0] + 2.
    إذا (*عم != 3.5) { إرجع 8. }

    // مؤشر في حلقة
    صحيح مجموع = 0.
    لكل (صحيح ي = 0؛ ي < 5؛ ي++) {
        مجموع = مجموع + *(&ق[0] + ي).
    }
    إذا (مجموع != 42) { إرجع 9. }

    اطبع "PASS".
    إرجع 0.
}
