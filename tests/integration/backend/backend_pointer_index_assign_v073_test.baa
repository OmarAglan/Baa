// ============================================================================
// اختبار الإسناد عبر فهرسة المؤشر — v0.7.3
// ============================================================================
// `م[i] = قيمة.` سكر نحوي لـ `*(م + i) = قيمة.`. كان التحليل الدلالي يرفضه
// بخطأ «ليس مصفوفة» مع أن القراءة `م[i]` مدعومة.
// RUN: expect-pass runtime
// ============================================================================

صحيح* عام_م = عدم.

صحيح عداد_النداءات = 0.

صحيح فهرس_بأثر(صحيح ي) {
    عداد_النداءات = عداد_النداءات + 1.
    إرجع ي.
}

صحيح الرئيسية() {
    // مؤشر محلي إلى صحيح
    صحيح ق[4] = {1, 2, 3, 4}.
    صحيح* م = &ق[0].
    م[0] = 10.
    م[3] = م[1] + م[2].
    إذا (ق[0] != 10 || ق[3] != 5) { إرجع 1. }

    // الفهرس يُقيَّم مرة واحدة
    م[فهرس_بأثر(2)] = 30.
    إذا (ق[2] != 30 || عداد_النداءات != 1) { إرجع 2. }

    // زيادة لاحقة عبر فهرسة المؤشر
    م[1]++.
    م[1]++.
    م[0]--.
    إذا (ق[1] != 4 || ق[0] != 9) { إرجع 3. }

    // عنصر ضيق: القيمة تُقص إلى حجم العنصر ولا تمس الجيران
    ط٨ ب[3] = {7, 7, 7}.
    ط٨* بم = &ب[0].
    بم[1] = 300.
    إذا (ب[0] != 7 || ب[1] != 44 || ب[2] != 7) { إرجع 4. }

    // عشري وحرف
    عشري ع[2] = {0.0, 0.0}.
    عشري* عم = &ع[0].
    عم[1] = 2.5.
    إذا (ع[1] != 2.5) { إرجع 5. }
    حرف ح[2] = {'أ', 'ب'}.
    حرف* حم = &ح[0].
    حم[1] = 'ج'.
    إذا (ح[1] != 'ج') { إرجع 6. }

    // مؤشر إلى مؤشر: الفهرسة الأولى تحمّل مؤشراً والثانية تكتب العنصر
    صحيح ص[2] = {0, 0}.
    صحيح* صفوف[2] = {&ق[0], &ص[0]}.
    صحيح** مم = &صفوف[0].
    مم[1][1] = 77.
    إذا (ص[1] != 77) { إرجع 7. }
    // كتابة مؤشر كاملاً في عنصر من مؤشرات
    مم[0] = &ص[0].
    مم[0][0] = 88.
    إذا (ص[0] != 88) { إرجع 8. }

    // مؤشر عام
    عام_م = &ق[0].
    عام_م[2] = 99.
    إذا (ق[2] != 99) { إرجع 9. }

    اطبع "PASS".
    إرجع 0.
}
