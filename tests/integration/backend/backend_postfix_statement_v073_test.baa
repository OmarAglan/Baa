// ============================================================================
// اختبار الزيادة/النقصان اللاحق كجملة مستقلة — v0.7.3
// ============================================================================
// كان `س++.` كجملة يمر من التحليل الدلالي ثم يفشل الخفض إلى IR بخطأ داخلي
// «عقدة جملة غير مدعومة».
// RUN: expect-pass runtime
// ============================================================================

صحيح الرئيسية() {
    صحيح س = 5.
    س++.
    س++.
    س--.
    إذا (س != 6) { إرجع 1. }

    ط٨ ب = 255.
    ب++.
    إذا (ب != 0) { إرجع 2. }

    صحيح ق[3] = {1, 2, 3}.
    ق[1]++.
    ق[2]--.
    إذا (ق[1] != 3 || ق[2] != 2) { إرجع 3. }

    صحيح خطوات = 0.
    طالما (خطوات < 4) {
        خطوات++.
    }
    إذا (خطوات != 4) { إرجع 4. }

    اطبع "PASS".
    إرجع 0.
}
