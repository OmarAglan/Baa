// RUN: runtime

#تضمين "baalib.baahd"

صحيح الرئيسية(صحيح عدد، نص[] معاملات) {
    إذا (عدد == ٢) {
        إذا (قارن_نص(معاملات[١]، "__process_child") == ٠) {
            نص قيمة = متغير_بيئة("BAA_PROCESS_TEST").
            إذا (قيمة == عدم || قارن_نص(قيمة، "ok") != ٠) {
                إذا (قيمة != عدم) { حرر_نص(قيمة). }
                إرجع ٩.
            }
            حرر_نص(قيمة).
            اطبع "PROCESS_STDOUT_OK".
            إرجع ٧.
        }

        إذا (قارن_نص(معاملات[١]، "__process_spin") == ٠) {
            صحيح مجموع = ٠.
            صحيح س = ٠.
            طالما (س < ٥٠٠٠٠٠٠٠٠) {
                مجموع = مجموع + (س % ٧).
                س = س + ١.
            }
            إرجع مجموع == -١.
        }
    }

    نص وسائط[٢] = {معاملات[٠]، "__process_child"}.
    نص بيئة[١] = {"BAA_PROCESS_TEST=ok"}.
    مقبض_عملية عملية = ابدأ_عملية(&وسائط[٠]، ٢، "."، &بيئة[٠]، ١،
                                   ".baa_process_output.txt"، ".baa_process_output.txt").
    إذا (عملية == عدم) { إرجع ١. }
    صحيح كود = انتظر_عملية(عملية).
    إذا (حالة_عملية(عملية) != ١) {
        حرر_عملية(عملية).
        إرجع ٢.
    }
    إذا (كود_خروج_عملية(عملية) != ٧) {
        حرر_عملية(عملية).
        إرجع ٢٣.
    }
    حرر_عملية(عملية).
    إذا (كود != ٧) { إرجع ٣. }

    عدم* ملف = فتح_ملف(".baa_process_output.txt"، "قراءة").
    إذا (ملف == عدم) { إرجع ٤. }
    نص سطر = اقرأ_سطر(ملف).
    اغلق_ملف(ملف).
    إذا (سطر == عدم || قارن_نص(سطر، "PROCESS_STDOUT_OK") != ٠) {
        إذا (سطر != عدم) { حرر_نص(سطر). }
        إرجع ٥.
    }
    حرر_نص(سطر).
    إذا (احذف_شجرة(".baa_process_output.txt") != ٠) { إرجع ٦. }

    إذا (انشئ_مجلدات(".baa_process_tree/a/b") != ٠) { إرجع ١٠. }
    عدم* ورقة = فتح_ملف(".baa_process_tree/a/b/file.txt"، "كتابة").
    إذا (ورقة == عدم) { إرجع ١١. }
    اكتب_سطر(ورقة، "ok").
    اغلق_ملف(ورقة).
    نص مجلد_طويل = ".baa_process_tree/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc".
    إذا (انشئ_مجلدات(مجلد_طويل) != ٠) { إرجع ١٥. }

    إذا (انقل_مسار(".baa_process_tree/a/b/file.txt"، ".baa_process_tree/a/moved.txt") != ٠) { إرجع ٣٠. }
    إذا (انقل_مسار(".baa_process_tree/a/b/file.txt"، ".baa_process_tree/a/again.txt") == ٠) { إرجع ٣١. }
    إذا (انقل_مسار(".baa_process_tree/a"، ".baa_process_tree/a/b") == ٠) { إرجع ٣٢. }
    إذا (انقل_مسار(".baa_process_tree/a"، ".baa_process_tree/جديد") != ٠) { إرجع ٣٣. }
    عدم* نسخة = فتح_ملف(".baa_process_tree/جديد/moved.txt"، "قراءة").
    إذا (نسخة == عدم) { إرجع ٣٤. }
    اغلق_ملف(نسخة).
    إذا (انقل_مسار(".baa_process_tree/جديد/moved.txt"، ".baa_process_tree/جديد/b") == ٠) { إرجع ٣٥. }
    إذا (انقل_مسار(".baa_process_tree/جديد"، "../خارج") == ٠) { إرجع ٣٦. }
    إذا (اجعل_قابلا_للتنفيذ(".baa_process_tree/جديد/moved.txt") != ٠) { إرجع ٣٧. }
    إذا (اجعل_قابلا_للتنفيذ(".baa_process_tree/جديد") == ٠) { إرجع ٣٨. }
    إذا (اجعل_قابلا_للتنفيذ(".baa_process_tree/مفقود") == ٠) { إرجع ٣٩. }

    عدم* بديل = فتح_ملف(".baa_process_tree/جديد/بديل.txt"، "كتابة").
    إذا (بديل == عدم) { إرجع ٤٠. }
    اكتب_سطر(بديل، "new").
    اغلق_ملف(بديل).
    إذا (استبدل_ملف(".baa_process_tree/جديد/بديل.txt"، ".baa_process_tree/جديد/moved.txt") != ٠) { إرجع ٤١. }
    عدم* مستبدل = فتح_ملف(".baa_process_tree/جديد/moved.txt"، "قراءة").
    إذا (مستبدل == عدم) { إرجع ٤٢. }
    نص سطر_مستبدل = اقرأ_سطر(مستبدل).
    اغلق_ملف(مستبدل).
    إذا (سطر_مستبدل == عدم || قارن_نص(سطر_مستبدل، "new") != ٠) { إرجع ٤٣. }
    حرر_نص(سطر_مستبدل).
    عدم* قديم = فتح_ملف(".baa_process_tree/جديد/بديل.txt"، "قراءة").
    إذا (قديم != عدم) { اغلق_ملف(قديم). إرجع ٤٤. }
    إذا (استبدل_ملف(".baa_process_tree/جديد/moved.txt"، ".baa_process_tree/جديد") == ٠) { إرجع ٤٥. }
    إذا (استبدل_ملف(".baa_process_tree/جديد"، ".baa_process_tree/مجلد_ملف") == ٠) { إرجع ٤٦. }
    إذا (استبدل_ملف(".baa_process_tree/مفقود"، ".baa_process_tree/جديد/moved.txt") == ٠) { إرجع ٤٧. }

    إذا (احذف_شجرة(".baa_process_tree") != ٠) { إرجع ١٢. }
    إذا (احذف_شجرة(".baa_process_tree") != ٠) { إرجع ١٣. }
    إذا (احذف_شجرة(".") == ٠) { إرجع ١٤. }

    نص وسائط_الغاء[٢] = {معاملات[٠]، "__process_spin"}.
    مقبض_عملية ملغاة = ابدأ_عملية(&وسائط_الغاء[٠]، ٢، عدم، عدم، ٠، عدم، عدم).
    إذا (ملغاة == عدم) { إرجع ٢٠. }
    إذا (!الغ_عملية(ملغاة)) {
        حرر_عملية(ملغاة).
        إرجع ٢١.
    }
    صحيح كود_الغاء = انتظر_عملية(ملغاة).
    حرر_عملية(ملغاة).
    إذا (كود_الغاء == ٠) { إرجع ٢٢. }

    إرجع ٠.
}
