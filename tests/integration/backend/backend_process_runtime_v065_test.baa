// RUN: runtime

#تضمين "baalib.baahd"

صحيح الرئيسية(صحيح عدد، نص[] معاملات) {
    إذا (عدد == ٢) {
        إذا (قارن_نص(معاملات[١]، "__process_child") == ٠) {
            نص قيمة = متغير_بيئة("BAA_PROCESS_TEST").
            إذا (قيمة == عدم || قارن_نص(قيمة، "ok") != ٠) {
                إذا (قيمة != عدم) { حرر_نص(قيمة). }
                إرجع ٩.
            }
            حرر_نص(قيمة).
            اطبع "PROCESS_STDOUT_OK".
            إرجع ٧.
        }

        إذا (قارن_نص(معاملات[١]، "__process_spin") == ٠) {
            صحيح مجموع = ٠.
            صحيح س = ٠.
            طالما (س < ٥٠٠٠٠٠٠٠٠) {
                مجموع = مجموع + (س % ٧).
                س = س + ١.
            }
            إرجع مجموع == -١.
        }
    }

    نص وسائط[٢] = {معاملات[٠]، "__process_child"}.
    نص بيئة[١] = {"BAA_PROCESS_TEST=ok"}.
    مقبض_عملية عملية = ابدأ_عملية(&وسائط[٠]، ٢، "."، &بيئة[٠]، ١،
                                   ".baa_process_output.txt"، ".baa_process_output.txt").
    إذا (عملية == عدم) { إرجع ١. }
    صحيح كود = انتظر_عملية(عملية).
    إذا (حالة_عملية(عملية) != ١) {
        حرر_عملية(عملية).
        إرجع ٢.
    }
    إذا (كود_خروج_عملية(عملية) != ٧) {
        حرر_عملية(عملية).
        إرجع ٢٣.
    }
    حرر_عملية(عملية).
    إذا (كود != ٧) { إرجع ٣. }

    عدم* ملف = فتح_ملف(".baa_process_output.txt"، "قراءة").
    إذا (ملف == عدم) { إرجع ٤. }
    نص سطر = اقرأ_سطر(ملف).
    اغلق_ملف(ملف).
    إذا (سطر == عدم || قارن_نص(سطر، "PROCESS_STDOUT_OK") != ٠) {
        إذا (سطر != عدم) { حرر_نص(سطر). }
        إرجع ٥.
    }
    حرر_نص(سطر).
    إذا (احذف_شجرة(".baa_process_output.txt") != ٠) { إرجع ٦. }

    إذا (انشئ_مجلدات(".baa_process_tree/a/b") != ٠) { إرجع ١٠. }
    عدم* ورقة = فتح_ملف(".baa_process_tree/a/b/file.txt"، "كتابة").
    إذا (ورقة == عدم) { إرجع ١١. }
    اكتب_سطر(ورقة، "ok").
    اغلق_ملف(ورقة).
    إذا (احذف_شجرة(".baa_process_tree") != ٠) { إرجع ١٢. }
    إذا (احذف_شجرة(".baa_process_tree") != ٠) { إرجع ١٣. }
    إذا (احذف_شجرة(".") == ٠) { إرجع ١٤. }

    نص وسائط_الغاء[٢] = {معاملات[٠]، "__process_spin"}.
    مقبض_عملية ملغاة = ابدأ_عملية(&وسائط_الغاء[٠]، ٢، عدم، عدم، ٠، عدم، عدم).
    إذا (ملغاة == عدم) { إرجع ٢٠. }
    إذا (!الغ_عملية(ملغاة)) {
        حرر_عملية(ملغاة).
        إرجع ٢١.
    }
    صحيح كود_الغاء = انتظر_عملية(ملغاة).
    حرر_عملية(ملغاة).
    إذا (كود_الغاء == ٠) { إرجع ٢٢. }

    إرجع ٠.
}
