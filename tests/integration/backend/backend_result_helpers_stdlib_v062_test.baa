#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

صحيح الرئيسية() {
    تحقق(نتيجة_ناجحة(كود_نجاح)، "نتيجة_ناجحة: كود_نجاح").
    تحقق(!نتيجة_ناجحة(كود_فشل)، "نتيجة_ناجحة: كود_فشل").
    تحقق(نتيجة_فاشلة(كود_فشل)، "نتيجة_فاشلة: كود_فشل").
    تحقق(!نتيجة_فاشلة(كود_نجاح)، "نتيجة_فاشلة: كود_نجاح").
    تحقق(كود_نتيجة(صواب) == كود_نجاح، "كود_نتيجة: صواب").
    تحقق(كود_نتيجة(خطأ) == كود_فشل، "كود_نتيجة: خطأ").

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }
    اطبع "FAIL".
    إرجع ١.
}
