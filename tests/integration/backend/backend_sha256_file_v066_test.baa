// RUN: expect-pass runtime
#تضمين "baalib.baahd"

صحيح الرئيسية() {
    نص تجزئة = تجزئة_ملف_SHA256("tests/fixtures/sha256_abc.txt").
    إذا (تجزئة == عدم) { إرجع ١. }
    منطقي مطابق = قارن_نص(تجزئة، "edeaaff3f1774ad2888673770c6d64097e391bc362d7d6fb34982ddf0efd18cb") == ٠.
    حرر_نص(تجزئة).
    إذا (!مطابق) { إرجع ٢. }
    إذا (تجزئة_ملف_SHA256("tests/fixtures/غير_موجود.sha256") != عدم) { إرجع ٣. }
    إرجع ٠.
}
