// ============================================================================
// اختبار `حجم` في تهيئة التخزين الساكن — v0.7.3
// ============================================================================
// كان `صحيح أ = حجم(صحيح).` على المستوى الأعلى يُرفض بـ«يجب أن تكون ثابتة
// وقت الترجمة» رغم أن `حجم` ثابت ترجمة، وكان خفض IR يضع صفراً مكانه.
// RUN: expect-pass runtime
// ============================================================================

صحيح أ = حجم(صحيح).
ساكن صحيح ب = حجم(حرف) * 2 + 1.
صحيح جدول[2] = {حجم(ط٨), حجم(عشري)}.

صحيح الرئيسية() {
    ساكن صحيح ج = حجم(ص٣٢).
    إذا (أ != 8) { إرجع 1. }
    إذا (ب != 17) { إرجع 2. }
    إذا (جدول[0] != 1 || جدول[1] != 8) { إرجع 3. }
    إذا (ج != 4) { إرجع 4. }
    اطبع "PASS".
    إرجع 0.
}
