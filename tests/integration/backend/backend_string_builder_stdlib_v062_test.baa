#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

عدم تحقق_نص(نص فعلي، نص متوقع، نص رسالة) {
    تحقق(فعلي != عدم، رسالة).
    إذا (فعلي != عدم) {
        إذا (قارن_نص(فعلي، متوقع) != ٠) {
            اطبع "فشل:".
            اطبع رسالة.
            اطبع "فعلي:".
            اطبع فعلي.
            اطبع "متوقع:".
            اطبع متوقع.
            فشل = فشل + ١.
        }
        حرر_نص(فعلي).
    }
}

صحيح الرئيسية() {
    باني_نص ب = أنشئ_باني_نص().
    تحقق(ب != عدم، "أنشئ_باني_نص: يعيد مقبضاً").
    تحقق(طول_باني_نص(ب) == ٠، "طول_باني_نص: يبدأ بصفر").

    تحقق(أضف_نص_للباني(ب، "hello")، "أضف_نص_للباني: hello").
    تحقق(أضف_نص_للباني(ب، " ")، "أضف_نص_للباني: فراغ").
    تحقق(أضف_نص_للباني(ب، "baa")، "أضف_نص_للباني: baa").
    تحقق(طول_باني_نص(ب) == ٩، "طول_باني_نص: بعد الإضافة").
    تحقق_نص(نص_الباني(ب)، "hello baa", "نص_الباني: لقطة كاملة").

    امسح_باني_نص(ب).
    تحقق(طول_باني_نص(ب) == ٠، "امسح_باني_نص: يعيد الطول للصفر").
    تحقق_نص(نص_الباني(ب)، "", "نص_الباني: بعد المسح").

    حرر_باني_نص(ب).

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }
    اطبع "FAIL".
    إرجع ١.
}
