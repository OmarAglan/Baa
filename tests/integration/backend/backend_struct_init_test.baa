تعداد لون {
    أحمر،
    أزرق،
}

هيكل نقطة {
    صحيح س.
    صحيح ص.
    منطقي نشط.
}

هيكل بطاقة {
    تعداد لون اللون.
    صحيح الرقم.
}

صحيح الرئيسية() {
    هيكل نقطة ن = { ص: ٢، س: ١ }.
    إذا (ن:س != ١) { إرجع ١. }
    إذا (ن:ص != ٢) { إرجع ٢. }
    إذا (ن:نشط != خطأ) { إرجع ٣. }

    ثابت هيكل نقطة ثابتة = { س: ٥، ص: ٦، نشط: صواب }.
    إذا (ثابتة:س != ٥) { إرجع ٤. }
    إذا (ثابتة:ص != ٦) { إرجع ٥. }
    إذا (ثابتة:نشط != صواب) { إرجع ٦. }

    هيكل بطاقة ب = { اللون: لون:أزرق، الرقم: ٧ }.
    إذا (ب:اللون != لون:أزرق) { إرجع ٧. }
    إذا (ب:الرقم != ٧) { إرجع ٨. }

    إرجع ٠.
}
