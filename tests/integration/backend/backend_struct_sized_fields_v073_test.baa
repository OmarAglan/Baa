// ============================================================================
// اختبار تخطيط حقول الهياكل ذات الأحجام المحددة — v0.7.3
// ============================================================================
// كان تخطيط الهياكل يعطي الحقول ص٨/ص١٦/ص٣٢/ط*/حرف/عشري/دالة حجماً صفرياً،
// فتتراكب مع الحقل التالي ويقع آخرها خارج حجم الهيكل. يتحقق هذا الاختبار من
// الحجم والمحاذاة ومن أن كتابة كل حقل لا تغيّر جاره.
// RUN: expect-pass runtime
// ============================================================================

هيكل مختلط {
    ص٨ أ.
    ص٣٢ ب.
    ط٨ ج.
    ص١٦ د.
    عشري هـ.
    ط٣٢ و.
    حرف ز.
    ص٨ ح.
}

هيكل ذيل {
    صحيح س.
    صحيح ص.
    ص٨ وسم.
}

اتحاد ضيق {
    ص٨ صغير.
    ط١٦ متوسط.
    ط٣٢ كبير.
}

صحيح ضاعف(صحيح س) {
    إرجع س * 2.
}

هيكل مع_دالة {
    ص٨ رقم.
    دالة(صحيح) -> صحيح ف.
}

صحيح الرئيسية() {
    // أ@0 ب@4 ج@8 د@10 هـ@16 و@24 ز@32 ح@40 → الحجم 48
    إذا (حجم(هيكل مختلط) != 48) { إرجع 1. }
    إذا (حجم(هيكل ذيل) != 24) { إرجع 2. }
    إذا (حجم(اتحاد ضيق) != 4) { إرجع 3. }
    إذا (حجم(هيكل مع_دالة) != 16) { إرجع 4. }

    هيكل مختلط م = { ح: -1 }.
    إذا (م:أ != 0) { إرجع 5. }
    إذا (كـ<صحيح>(م:ز) != 0) { إرجع 6. }
    إذا (م:ح != -1) { إرجع 7. }

    م:أ = كـ<ص٨>(-7).
    م:ب = -100000.
    م:ج = 200.
    م:د = -30000.
    م:هـ = 2.5.
    م:و = 4000000000.
    م:ز = 'ب'.
    م:ح = 99.

    إذا (م:أ != -7) { إرجع 8. }
    إذا (م:ب != -100000) { إرجع 9. }
    إذا (م:ج != 200) { إرجع 10. }
    إذا (م:د != -30000) { إرجع 11. }
    إذا (م:هـ != 2.5) { إرجع 12. }
    إذا (م:و != 4000000000) { إرجع 13. }
    إذا (م:ز != 'ب') { إرجع 14. }
    إذا (م:ح != 99) { إرجع 15. }

    // الحقل الأخير الضيق يبقى داخل الهيكل ويُصفّر بالتهيئة الجزئية.
    هيكل ذيل ذ = { س: 1, ص: 2 }.
    إذا (ذ:وسم != 0) { إرجع 16. }
    ذ:وسم = 5.
    إذا (ذ:س != 1 || ذ:ص != 2 || ذ:وسم != 5) { إرجع 17. }

    هيكل مع_دالة د٢.
    د٢:رقم = 3.
    د٢:ف = ضاعف.
    دالة(صحيح) -> صحيح ف = د٢:ف.
    إذا (ف(21) != 42) { إرجع 18. }
    إذا (د٢:رقم != 3) { إرجع 19. }

    اطبع "PASS".
    إرجع 0.
}
