// يغطي عقد v0.6.4 لمساعدات النص: الطول، المقارنة، والنسخ المملوك.
#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

صحيح الرئيسية() {
    تحقق(طول_نص("") == ٠، "طول النص الفارغ").
    تحقق(طول_نص("باء") == ٣، "طول نص عربي يحسب محارف باء").

    تحقق(قارن_نص(""، "") == ٠، "مقارنة نصين فارغين").
    تحقق(قارن_نص(""، "أ") < ٠، "النص الفارغ أصغر من غير الفارغ").
    تحقق(قارن_نص("با"، "باء") < ٠، "البادئة الأقصر أصغر").
    تحقق(قارن_نص("باء"، "با") > ٠، "النص الأطول بعد بادئة مشتركة أكبر").

    نص فارغ = نسخ_نص("").
    إذا (فارغ == عدم) {
        تحقق(خطأ، "نسخ النص الفارغ فشل").
    } وإلا {
        تحقق(طول_نص(فارغ) == ٠، "نسخة النص الفارغ طولها صفر").
        تحقق(قارن_نص(فارغ، "") == ٠، "نسخة النص الفارغ تطابق الأصل").
        حرر_نص(فارغ).
    }

    نص الأصل = دمج_نص("با"، "ء").
    إذا (الأصل == عدم) {
        تحقق(خطأ، "دمج النص الأصلي فشل").
    } وإلا {
        نص نسخة = نسخ_نص(الأصل).
        حرر_نص(الأصل).

        إذا (نسخة == عدم) {
            تحقق(خطأ، "نسخ النص العربي فشل").
        } وإلا {
            تحقق(قارن_نص(نسخة، "باء") == ٠، "النسخة تبقى مستقلة بعد تحرير الأصل").
            تحقق(طول_نص(نسخة) == ٣، "طول النسخة بعد تحرير الأصل").
            حرر_نص(نسخة).
        }
    }

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }

    اطبع "FAIL".
    إرجع ١.
}
