// RUN: expect-pass,runtime
// EXPECT-OUT: PASS

#تضمين "tests/fixtures/include_utf8_validation_header.baahd"

صحيح الرئيسية() {
    صحيح نتيجة = ٠.

    صحيح عدد_مُعرّف = قيمة_مضمّنة().
    إذا (عدد_مُعرّف == ٧) {
        نتيجة = نتيجة + ١.
    }

    حرف ألف = 'أ'.
    إذا (ألف == محرف_مضمّن()) {
        نتيجة = نتيجة + ١.
    }

    نص نص_مشكول = "سَلام".
    حرف سين = نص_مشكول[٠].
    حرف فتحة = نص_مشكول[١].
    إذا (سين == 'س') {
        نتيجة = نتيجة + ١.
    }
    إذا (فتحة == 'َ') {
        نتيجة = نتيجة + ١.
    }

    إذا (نتيجة == ٤) {
        اطبع "PASS".
        إرجع ٠.
    }

    إرجع ١.
}
