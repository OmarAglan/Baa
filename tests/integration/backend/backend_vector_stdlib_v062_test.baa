#تضمين "stdlib/baalib.baahd"

صحيح فشل = ٠.

عدم تحقق(منطقي شرط، نص رسالة) {
    إذا (!شرط) {
        اطبع "فشل:".
        اطبع رسالة.
        فشل = فشل + ١.
    }
}

صحيح الرئيسية() {
    متجه أعداد = أنشئ_متجه(حجم(صحيح)).
    تحقق(أعداد != عدم، "أنشئ_متجه: مقبض غير فارغ").
    إذا (أعداد == عدم) { إرجع ١. }

    تحقق(طول_متجه(أعداد) == ٠، "طول_متجه: يبدأ بصفر").
    تحقق(سعة_متجه(أعداد) == ٠، "سعة_متجه: تبدأ بصفر").
    تحقق(بيانات_متجه(أعداد) == عدم، "بيانات_متجه: يبدأ بدون مخزن").

    لكل (صحيح س = ٠؛ س < ٦؛ س = س + ١) {
        صحيح قيمة = (س + ١) * ١٠.
        تحقق(ادفع_متجه(أعداد، &قيمة)، "ادفع_متجه: نجاح").
    }

    تحقق(طول_متجه(أعداد) == ٦، "طول_متجه: بعد الإدخال").
    تحقق(سعة_متجه(أعداد) >= ٦، "سعة_متجه: توسعت لتكفي العناصر").

    صحيح* بيانات = كـ<صحيح*>(بيانات_متجه(أعداد)).
    تحقق(بيانات != عدم، "بيانات_متجه: مخزن غير فارغ بعد الإدخال").
    لكل (صحيح س = ٠؛ س < ٦؛ س = س + ١) {
        تحقق(*(بيانات + س) == (س + ١) * ١٠، "بيانات_متجه: حفظ ترتيب العناصر").
    }

    صحيح آخر = ٠.
    تحقق(اسحب_متجه(أعداد، &آخر)، "اسحب_متجه: نجاح مع وجهة").
    تحقق(آخر == ٦٠، "اسحب_متجه: يعيد آخر عنصر").
    تحقق(طول_متجه(أعداد) == ٥، "طول_متجه: ينقص بعد السحب").

    تحقق(اسحب_متجه(أعداد، عدم)، "اسحب_متجه: يسمح بتجاهل القيمة").
    تحقق(طول_متجه(أعداد) == ٤، "طول_متجه: ينقص عند تجاهل القيمة").

    لكل (صحيح س = ٠؛ س < ٤؛ س = س + ١) {
        تحقق(اسحب_متجه(أعداد، &آخر)، "اسحب_متجه: تفريغ").
    }
    تحقق(طول_متجه(أعداد) == ٠، "طول_متجه: صفر بعد التفريغ").
    تحقق(!اسحب_متجه(أعداد، &آخر)، "اسحب_متجه: يفشل على متجه فارغ").

    حرر_متجه(أعداد).
    حرر_متجه(عدم).

    متجه مرفوض = أنشئ_متجه(٠).
    تحقق(مرفوض == عدم، "أنشئ_متجه: يرفض حجم عنصر صفر").

    إذا (فشل == ٠) {
        اطبع "PASS".
        إرجع ٠.
    }
    اطبع "FAIL".
    إرجع ١.
}
