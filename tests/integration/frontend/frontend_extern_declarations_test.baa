// RUN: runtime
// EXPECT-OUT: PASS

خارجي صحيح عداد_مشترك.
خارجي صحيح قيم_مشتركة[٣].
خارجي صحيح ضاعف(صحيح قيمة).

صحيح عداد_مشترك = ٧.
صحيح قيم_مشتركة[٣] = {١، ٢، ٣}.

صحيح ضاعف(صحيح قيمة) {
    إرجع قيمة * ٢.
}

صحيح الرئيسية() {
    إذا (عداد_مشترك != ٧) {
        إرجع ١.
    }
    إذا (قيم_مشتركة[٠] + قيم_مشتركة[١] + قيم_مشتركة[٢] != ٦) {
        إرجع ٢.
    }
    إذا (ضاعف(٥) != ١٠) {
        إرجع ٣.
    }
    اطبع "PASS".
    إرجع ٠.
}
