// RUN: expect-pass,compile-only
// FLAGS: -S -fruntime-checks=bounds+shift
// EXPECT-ASM: فشل_حدود
// EXPECT-ASM: فهرس خارج حدود النص
// EXPECT-ASM: فشل_إزاحة_غير_صالحة
// EXPECT-NOT-ASM: فشل_قسمة_على_صفر
// EXPECT-NOT-ASM: فشل_مؤشر_فارغ

صحيح اثنان() {
    إرجع ٢.
}

صحيح أربعة_وستون() {
    إرجع ٦٤.
}

صحيح صفر() {
    إرجع ٠.
}

صحيح الرئيسية() {
    نص س = "أب".
    صحيح ن = اثنان().
    حرف ح = س[ن].
    صحيح* م = عدم.
    صحيح ف = *م.
    صحيح ب = صفر().
    صحيح ق = ١٠ / ب.
    صحيح ش = ١ << أربعة_وستون().
    إرجع ح + ف + ق + ش.
}
